/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include "sm8750.dtsi"
#include "pm8550.dtsi"
#define PMK8550VE_SID 8
#include "pm8550ve.dtsi"
#include "pmih0108.dtsi"
#include "pmk8550.dtsi"
#include "sm8750-pmics.dtsi"

/ {
	model = "Lenovo Legion Y700 Gen4";
	compatible = "lenovo,elden", "qcom,sm8750";
	chassis-type = "tablet";

	/* Stock CPU/GPU thermal HAL junction limit: 105 C, 5 C hysteresis. */
	thermal-zones {
		cpu-0-0-0-thermal {
			polling-delay-passive = <100>;

			trips {
				cpu_0_0_0_passive: passive {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_0_0_0_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-0-0-1-thermal {
			polling-delay-passive = <100>;

			trips {
				cpu_0_0_1_passive: passive {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_0_0_1_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-0-1-0-thermal {
			polling-delay-passive = <100>;

			trips {
				cpu_0_1_0_passive: passive {
					temperature = <105000>;
