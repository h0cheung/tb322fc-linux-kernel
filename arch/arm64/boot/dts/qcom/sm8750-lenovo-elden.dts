&gpi_dma1 {
	status = "okay";
};

&gpi_dma2 {
	status = "okay";
};

&i2c5 {
	status = "okay";

	typec-mux@42 {
		compatible = "fcs,fsa4480";
		reg = <0x42>;

		vcc-supply = <&vreg_bob1>;

		mode-switch;
		orientation-switch;

		port {
			fsa4480_hs_sbu_mux: endpoint {
				remote-endpoint = <&pmic_glink_hs_sbu>;
			};
		};
	};

	typec-mux@43 {
		compatible = "fcs,fsa4480";
		reg = <0x43>;

		vcc-supply = <&vreg_bob1>;

		mode-switch;
		orientation-switch;

		port {
			fsa4480_sbu_mux: endpoint {
				remote-endpoint = <&pmic_glink_sbu>;
			};
		};
	};

	eusb_repeater: redriver@4f {
		compatible = "nxp,ptn3222"; /* PTN3222DUK */
		reg = <0x4f>;
		#phy-cells = <0>;

		vdd3v3-supply = <&vreg_l5b_3p1>;
		vdd1v8-supply = <&vreg_l15b_1p8>;

		/* Long-edge USB C1 tuning from the Lenovo downstream DT. */
		qcom,param-override-seq-c1 = <0x40 0x06>,
					   <0x22 0x07>,
					   <0x65 0x08>,
					   <0x03 0x0a>;

		reset-gpios = <&pm8550ve_gpios 6 GPIO_ACTIVE_LOW>;

		pinctrl-0 = <&eusb_reset_n>;
		pinctrl-names = "default";
	};
};

&i2c6 {
	status = "okay";

	haptics_left: haptic-controller@5a {
		compatible = "awinic,aw86937";
		firmware-name = "awinic/y700-gen4-haptic.bin";
		awinic,ram-waveform-index = <4>;
		reg = <0x5a>;

		interrupts-extended = <&tlmm 99 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 127 GPIO_ACTIVE_LOW>;

		pinctrl-0 = <&haptics_left_default>;
		pinctrl-names = "default";

	};

	haptics_right: haptic-controller@5b {
		compatible = "awinic,aw86937";
		firmware-name = "awinic/y700-gen4-haptic.bin";
		awinic,ram-waveform-index = <4>;
		reg = <0x5b>;

		interrupts-extended = <&tlmm 95 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 119 GPIO_ACTIVE_LOW>;

		pinctrl-0 = <&haptics_right_default>;
		pinctrl-names = "default";
	};
};

&i2c9 {
	status = "okay";

	speaker_left: amplifier@34 {
		compatible = "awinic,aw88461";
		reg = <0x34>;
		#sound-dai-cells = <0>;
		reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
		firmware-name = "awinic/y700-gen4-speakers.bin";
		awinic,audio-channel = <0>;
		sound-name-prefix = "Left";
	};

	speaker_right: amplifier@37 {
		compatible = "awinic,aw88461";
		reg = <0x37>;
		#sound-dai-cells = <0>;
		reset-gpios = <&tlmm 128 GPIO_ACTIVE_LOW>;
		firmware-name = "awinic/y700-gen4-speakers.bin";
		awinic,audio-channel = <1>;
		sound-name-prefix = "Right";
	};
};

&i2c10 {
	status = "okay";

	pmic@2f {
		compatible = "willsemi,wl2868c";
		reg = <0x2f>;
		reset-gpios = <&tlmm 126 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&camera_pmic_default>;

		regulators {
			/* Voltages include the offsets programmed by stock firmware. */
			camera_ldo1: ldo1 {
				regulator-name = "camera_ldo1";
				regulator-min-microvolt = <1128000>;
				regulator-max-microvolt = <1128000>;
			};

			camera_ldo2: ldo2 {
				regulator-name = "camera_ldo2";
				regulator-min-microvolt = <1288000>;
				regulator-max-microvolt = <1288000>;
			};

			camera_ldo3: ldo3 {
				regulator-name = "camera_ldo3";
				regulator-min-microvolt = <2816000>;
				regulator-max-microvolt = <2816000>;
			};

			camera_ldo4: ldo4 {
				regulator-name = "camera_ldo4";
				regulator-min-microvolt = <2824000>;
				regulator-max-microvolt = <2824000>;
			};

			camera_ldo5: ldo5 {
				regulator-name = "camera_ldo5";
				regulator-min-microvolt = <2808000>;
				regulator-max-microvolt = <2808000>;
			};

			camera_ldo7: ldo7 {
				regulator-name = "camera_ldo7";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};
		};
	};

	/*
	 * bias@3e, as9702 or aw37504
	 *
	 * gpio72/gpio73: enable pin for OUTP/OUTN
	 * In practical, register programming is not required for as9702
	 *
	 * as9702: (REG02H[7:0]=0xf1)
	 * reg: 0x00 0x01 0x03
	 * val: 0x15 0x12 0x73
	 *
	 * aw37504: (REG04H[1:0]=0x01)
	 * reg: 0x00 0x01 0x03 0x04
	 * val: 0x15 0x12 0x43 0x09
	 */

	backlight: backlight@76 {
		compatible = "awinic,aw99706";
		reg = <0x76>;

		enable-gpios = <&tlmm 88 GPIO_ACTIVE_HIGH>;

		pinctrl-0 = <&aw99706_bl_active>;
		pinctrl-names = "default";

		default-brightness = <511>;
		max-brightness = <4095>;

		awinic,dim-mode = <1>;
		awinic,sw-freq-hz = <750000>;
		awinic,sw-ilmt-microamp = <3000000>;
		awinic,uvlo-thres-microvolt = <2200000>;
		awinic,iled-max-microamp = <30000>;
		awinic,ramp-ctl = <3>;
	};
};

&camss {
	status = "okay";

	vdd-csiphy0-0p9-supply = <&vreg_l1f_0p88>;
	vdd-csiphy0-1p2-supply = <&vreg_l3g_1p2>;
	vdd-csiphy1-0p9-supply = <&vreg_l1f_0p88>;
	vdd-csiphy1-1p2-supply = <&vreg_l3g_1p2>;
	vdd-csiphy2-0p9-supply = <&vreg_l3i_0p88>;
	vdd-csiphy2-1p2-supply = <&vreg_l3g_1p2>;
	vdd-csiphy3-0p9-supply = <&vreg_l1f_0p88>;
	vdd-csiphy3-1p2-supply = <&vreg_l3g_1p2>;
	vdd-csiphy4-0p9-supply = <&vreg_l3i_0p88>;
	vdd-csiphy4-1p2-supply = <&vreg_l3g_1p2>;
	vdd-csiphy5-0p9-supply = <&vreg_l1f_0p88>;
	vdd-csiphy5-1p2-supply = <&vreg_l3g_1p2>;

	ports {
		port@3 {
			reg = <3>;

			camss_rear: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&rear_camera_out>;
			};
		};

		port@4 {
			reg = <4>;

			camss_front: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&front_camera_out>;
			};
		};
	};
};

&cci0 {
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&cci0_0_default>;
	pinctrl-1 = <&cci0_0_sleep>;
};

&cci0_i2c0 {
	clock-frequency = <400000>;

	rear_lens: lens@c {
		compatible = "giantec,gt9764";
		reg = <0x0c>;
		vddio-supply = <&camera_ldo7>;
		vdd-supply = <&camera_ldo5>;
		giantec,aac-mode = <0x40>;
		giantec,aac-timing = <0x7c>;
		settling-time-us = <7000>;
	};

	rear_camera: camera@56 {
		compatible = "samsung,s5kjns";
		reg = <0x56>;
		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK3_CLK>;
		assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK3_CLK>;
		assigned-clock-rates = <19200000>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		reset-gpios = <&tlmm 11 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&rear_camera_default>;
		dovdd-supply = <&camera_ldo7>;
		dvdd-supply = <&camera_ldo1>;
		avdd-supply = <&camera_ldo4>;
		lens-focus = <&rear_lens>;
		flash-leds = <&rear_flash>;
		orientation = <1>;
		rotation = <90>;

		port {
			rear_camera_out: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <672000000>;
				remote-endpoint = <&camss_rear>;
			};
		};
	};
};

&cci1 {
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&cci1_0_default>;
	pinctrl-1 = <&cci1_0_sleep>;
};

&cci1_i2c0 {
	clock-frequency = <400000>;

	front_camera: camera@31 {
		compatible = "galaxycore,gc08a8";
		reg = <0x31>;
		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
		assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
		assigned-clock-rates = <19200000>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		reset-gpios = <&tlmm 7 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&front_camera_default>;
		dovdd-supply = <&camera_ldo7>;
		dvdd-supply = <&camera_ldo2>;
		avdd-supply = <&camera_ldo3>;
		orientation = <0>;
		rotation = <270>;

		port {
			front_camera_out: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <336000000>;
				remote-endpoint = <&camss_front>;
			};
		};
	};
};

&gpu {
	status = "okay";
};

&gmu {
	status = "okay";
};

&mdss {
	memory-region = <&splash_mem>;
	/delete-property/ iommus;
	status = "okay";
};

/* Keep the SMMU attachment on the DPU child as in the authoritative DTB. */
&mdss_mdp {
	iommus = <&apps_smmu 0x800 0x2>;
};

&mdss_dp0 {
	status = "okay";
};

&mdss_dp0_out {
	remote-endpoint = <&usb_dp_qmpphy_dp_in>;
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3g_1p2>;

	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;
	qcom,master-dsi;

	status = "okay";

	panel0: panel@0 {
		compatible = "csot,pp8807hb1-1", "novatek,nt36536";
		reg = <0>;

		reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;

		vddio-supply = <&vreg_1v8_vddio>;
		vsp-supply = <&vreg_6v1_vsp>;
		vsn-supply = <&vreg_5v8_vsn>;

		pinctrl-0 = <&disp0_reset_n_active>, <&mdp_vsync_active>;
		pinctrl-1 = <&disp0_reset_n_suspend>, <&mdp_vsync_suspend>;
		pinctrl-names = "default", "sleep";

		backlight = <&backlight>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				panel_in_0: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;

				panel_in_1: endpoint {
					remote-endpoint = <&mdss_dsi1_out>;
				};
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel_in_0>;
	data-lanes = <0 1 2>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l3i_0p88>;
	phy-type = <PHY_TYPE_CPHY>;
	/* Exact downstream timing@0 values for the CSOT 3K C-PHY mode. */
	qcom,cphy-timing-ctrl = [00 00 00 00 23 23 08 19 08 02 04 00 00 00];

	status = "okay";
};

&mdss_dsi1 {
	/* Bonded DSI, source to dsi0_phy PLL */
	clocks = <&dispcc DISP_CC_MDSS_BYTE1_CLK>,
		 <&dispcc DISP_CC_MDSS_BYTE1_INTF_CLK>,
		 <&dispcc DISP_CC_MDSS_PCLK1_CLK>,
		 <&dispcc DISP_CC_MDSS_ESC1_CLK>,
		 <&dispcc DISP_CC_MDSS_AHB_CLK>,
		 <&gcc GCC_DISP_HF_AXI_CLK>,
		 <&mdss_dsi0_phy DSI_PIXEL_PLL_CLK>,
		 <&mdss_dsi0_phy DSI_BYTE_PLL_CLK>,
		 <&dispcc DISP_CC_ESYNC1_CLK>,
		 <&dispcc DISP_CC_OSC_CLK>,
		 <&dispcc DISP_CC_MDSS_BYTE1_CLK_SRC>,
		 <&dispcc DISP_CC_MDSS_PCLK1_CLK_SRC>;

	vdda-supply = <&vreg_l3g_1p2>;

	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;

	status = "okay";
};

&mdss_dsi1_out {
	remote-endpoint = <&panel_in_1>;
	data-lanes = <0 1 2>;
};

&mdss_dsi1_phy {
	vdds-supply = <&vreg_l3i_0p88>;
	phy-type = <PHY_TYPE_CPHY>;
	qcom,cphy-timing-ctrl = [00 00 00 00 23 23 08 19 08 02 04 00 00 00];

	status = "okay";
};

&pcie0 {
	vdda-supply = <&vreg_l1f_0p88>;
	vddpe-3v3-supply = <&vreg_l3g_1p2>;

	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l1f_0p88>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&pcieport0 {
	wake-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;

	/* WCN7861 (Peach), Lenovo downstream PCI ID 17cb:110e. */
	wifi@0 {
		compatible = "pci17cb,110e";
		qcom,msi-iova = /bits/ 64 <0x18000000>;
		reg = <0x10000 0x0 0x0 0x0 0x0>;

		vddrfacmn-supply = <&vreg_wlan_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_wlan_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_wlan_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_wlan_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_wlan_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_wlan_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_wlan_pmu_rfa_1p8>;
		vddpcie0p9-supply = <&vreg_wlan_pmu_pcie_0p9>;
		vddpcie1p8-supply = <&vreg_wlan_pmu_pcie_1p8>;
	};
};

&pm8550ve_f_gpios {
	bt_uwb_en: bt-uwb-en-state {
		pins = "gpio3";
		function = "normal";
		power-source = <1>;
		bias-disable;
		output-low;
	};

	bt_fmd_clk_en: bt-fmd-clk-en-state {
		pins = "gpio6";
		function = "normal";
		power-source = <1>;
		bias-disable;
		input-enable;
	};
};

&pm8550_flash {
	status = "okay";
	power-supplies = <&pmic_glink>;
	qcom,battery-current-limit-microamp = <4500000>;
	qcom,battery-voltage-min-microvolt = <2850000>;

	rear_flash: led-0 {
		function = LED_FUNCTION_FLASH;
		color = <LED_COLOR_ID_WHITE>;
		led-sources = <1 4>;
		led-max-microamp = <1000000>;
		flash-max-microamp = <2000000>;
		flash-max-timeout-us = <1280000>;
	};
};

&pm8550_gpios {
	volume_up_n: volume-up-n-state {
		pins = "gpio6";
		function = "normal";
		bias-pull-up;
		input-enable;
		power-source = <1>;
	};
};

&pm8550ve_gpios {
	eusb_reset_n: eusb-reset-n-state {
		pins = "gpio6";
		function = "normal";
		bias-disable;
		power-source = <1>;
		qcom,drive-strength = <2>;
	};
};

&pmih0108_eusb2_repeater {
	vdd18-supply = <&vreg_l15b_1p8>;
	vdd3-supply = <&vreg_l5b_3p1>;
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;

	status = "okay";
};

&qupv3_1 {
	status = "okay";
};

&qupv3_2 {
	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "qcom/sm8750/adsp.mdt",
			"qcom/sm8750/adsp_dtb.mdt";

	status = "okay";

	glink-edge {
		fastrpc {
			/* Exact SIDs preserve the existing firmware SMMU mappings. */
			compute-cb@3 {
				iommus = <&apps_smmu 0x1003 0>,
					 <&apps_smmu 0x1043 0>,
					 <&apps_smmu 0x1063 0>,
					 <&apps_smmu 0x1083 0>;
			};

			compute-cb@4 {
				iommus = <&apps_smmu 0x1004 0>,
					 <&apps_smmu 0x1044 0>,
					 <&apps_smmu 0x1064 0>,
					 <&apps_smmu 0x1084 0>;
				qcom,nsessions = <8>;
			};

			compute-cb@5 {
				iommus = <&apps_smmu 0x1005 0>,
					 <&apps_smmu 0x1045 0>,
					 <&apps_smmu 0x1065 0>,
					 <&apps_smmu 0x1085 0>;
			};

			compute-cb@6 {
				iommus = <&apps_smmu 0x1006 0>,
					 <&apps_smmu 0x1046 0>,
					 <&apps_smmu 0x1066 0>,
					 <&apps_smmu 0x1086 0>;
			};

			compute-cb@7 {
				iommus = <&apps_smmu 0x1007 0>,
					 <&apps_smmu 0x1047 0>,
					 <&apps_smmu 0x1067 0>,
					 <&apps_smmu 0x1087 0>;
			};

			compute-cb@8 {
				iommus = <&apps_smmu 0x1008 0>,
					 <&apps_smmu 0x1048 0>,
					 <&apps_smmu 0x1068 0>,
					 <&apps_smmu 0x1088 0>;
			};
		};
	};
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm8750/LENOVO/elden/cdsp.mbn",
			"qcom/sm8750/LENOVO/elden/cdsp_dtb.mbn";

	status = "disabled";
};

&spi4 {
	pinctrl-0 = <&qup_spi4_data_clk>;
	pinctrl-1 = <&touch_spi_data_sleep>;
	pinctrl-names = "default", "sleep";

	status = "okay";

	touchscreen@0 {
		compatible = "novatek,nt36536-ts";
		reg = <0>;

		interrupt-parent = <&tlmm>;
		interrupts = <162 IRQ_TYPE_EDGE_FALLING>;

		pinctrl-0 = <&touch_active &qup_spi4_cs>;
		pinctrl-1 = <&touch_sleep &touch_spi_cs_sleep>;
		pinctrl-names = "default", "sleep";

		spi-max-frequency = <10000000>;
		firmware-name = "novatek_ts_csot_3k_fw.bin";
		panel = <&panel0>;

		/* Stock reports inclusive coordinate maxima 19040 and 30400. */
		touchscreen-size-x = <19041>;
		touchscreen-size-y = <30401>;

		status = "okay";
	};
};

&sdhc_2 {
	cd-gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;

	vmmc-supply = <&vreg_l9b_2p9>;
	vqmmc-supply = <&vreg_l8b_1p8>;

	no-sdio;
	no-mmc;

	pinctrl-0 = <&sdc2_default &sdc2_card_det_n>;
	pinctrl-1 = <&sdc2_sleep &sdc2_card_det_n>;
	pinctrl-names = "default", "sleep";

	status = "okay";
};

&q6apmdai {
	/* Exact IDs avoid probing mask widths while preserving boot mappings. */
	iommus = <&apps_smmu 0x1001 0>, <&apps_smmu 0x1081 0>,
		 <&apps_smmu 0x1041 0>, <&apps_smmu 0x1061 0>;
};

&q6apmbedai {
	#address-cells = <1>;
	#size-cells = <0>;

	dai@12 {
		reg = <SECONDARY_MI2S_RX>;
		clocks = <&q6prmcc LPASS_CLK_ID_SEC_MI2S_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
		clock-names = "bclk";
	};
};

&qup_spi4_cs {
	/delete-property/ bias-disable;
	bias-pull-up;
};

&qup_spi4_data_clk {
	/delete-property/ bias-disable;
	bias-pull-down;
};

&tlmm {
	/* For CDT: <32 3> <37 2> <77 1>; */
	/* reserved for secure world */
	gpio-reserved-ranges = <39 1>, <74 1>;

	camera_pmic_default: camera-pmic-default-state {
		pins = "gpio126";
		function = "gpio";
		bias-disable;
	};

	cci0_0_default: cci0-0-default-state {
		sda-pins {
			pins = "gpio113";
			function = "cci_i2c_sda";
			drive-strength = <2>;
			bias-pull-up;
		};

		scl-pins {
			pins = "gpio114";
			function = "cci_i2c_scl";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	cci0_0_sleep: cci0-0-sleep-state {
		pins = "gpio113", "gpio114";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	cci1_0_default: cci1-0-default-state {
		sda-pins {
			pins = "gpio117";
			function = "cci_i2c_sda";
			drive-strength = <2>;
			bias-pull-up;
		};

		scl-pins {
			pins = "gpio118";
			function = "cci_i2c_scl";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	cci1_0_sleep: cci1-0-sleep-state {
		pins = "gpio117", "gpio118";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	rear_camera_default: rear-camera-default-state {
		mclk-pins {
			pins = "gpio92";
			function = "cam_mclk";
			drive-strength = <2>;
			bias-disable;
		};

		reset-pins {
			pins = "gpio11";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};

	front_camera_default: front-camera-default-state {
		mclk-pins {
			pins = "gpio93";
			function = "cam_aon_mclk4";
			drive-strength = <2>;
			bias-disable;
		};

		reset-pins {
			pins = "gpio7";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};

	secondary_mi2s_default: secondary-mi2s-default-state {
		clock-pins {
			pins = "gpio121";
			function = "i2s1_sck";
			drive-strength = <8>;
			bias-disable;
		};
		word-select-pins {
			pins = "gpio123";
			function = "i2s1_ws";
			drive-strength = <8>;
			bias-disable;
		};
		data-pins {
			pins = "gpio124";
			function = "i2s1_data1";
			drive-strength = <8>;
			bias-disable;
		};
	};

	haptics_left_default: haptics-left-default-state {
		pins = "gpio99", "gpio127";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	haptics_right_default: haptics-right-default-state {
		pins = "gpio95", "gpio119";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	touch_active: touch-active-state {
		pins = "gpio162";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	touch_spi_cs_sleep: touch-spi-cs-sleep-state {
		pins = "gpio51";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	touch_spi_data_sleep: touch-spi-data-sleep-state {
		pins = "gpio48", "gpio49", "gpio50";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	touch_sleep: touch-sleep-state {
		pins = "gpio162";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	aw99706_bl_active: aw99706-bl-active-state {
		pins = "gpio88";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	disp0_reset_n_active: disp0-reset-n-active-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	disp0_reset_n_suspend: disp0-reset-n-suspend-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	wlan_en: wlan-en-state {
		pins = "gpio16";
		function = "gpio";
		drive-strength = <16>;
		bias-pull-up;
	};

	wlan_sw_ctrl: wlan-sw-ctrl-state {
		pins = "gpio18";
		function = "wcn_sw_ctrl";
	};

	wlan_sw_ctrl_wl_cx: wlan-sw-ctrl-wl-cx-state {
		pins = "gpio19";
		function = "wcn_sw";
	};

	/* Stock CNSS drives host SOL low before the WLFW handshake. */
	wlan_host_sol: wlan-host-sol-state {
		pins = "gpio202";
		function = "gpio";
		drive-strength = <4>;
		bias-pull-down;
		output-low;
	};

	eusb_mux: eusb-mux-state {
		pins = "gpio29";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	vddio_reg_en: vddio-reg-en-state {
		pins = "gpio161";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	mdp_vsync_active: mdp-vsync-active-state {
		pins = "gpio86";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	mdp_vsync_suspend: mdp-vsync-suspend-state {
		pins = "gpio86";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	sdc2_card_det_n: sd-card-det-n-state {
		pins = "gpio55";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	vsp_reg_en: vsp-reg-en-state {
		pins = "gpio72";
		function = "gpio";
		drive-strength = <16>;
		bias-pull-up;
	};

	vsn_reg_en: vsn-reg-en-state {
		pins = "gpio73";
		function = "gpio";
		drive-strength = <16>;
		bias-pull-up;
	};
};

&uart14 {
	pinctrl-names = "default";
	pinctrl-0 = <&qup_uart14_default>, <&qup_uart14_cts_rts>;

	status = "okay";

	/* WCN7861 Peach/Brahma v2 uses the WCN7850 UART protocol. */
	bluetooth {
		compatible = "qcom,wcn7861-bt";

		firmware-name = "brhbtnv20.bin", "brhbtfw20.tlv";
		/* Android-assigned public address, stored little-endian in DT. */
		local-bd-address = [58 97 9c 62 22 22];

		vddrfacmn-supply = <&vreg_wlan_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_wlan_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_wlan_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_wlan_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_wlan_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_wlan_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_wlan_pmu_rfa_1p8>;

		max-speed = <8000000>;
	};
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1j_0p91>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&ufs_mem_hc {
	reset-gpios = <&tlmm 215 GPIO_ACTIVE_LOW>;

	vcc-supply = <&vreg_l17b_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1d_1p2>;
	vccq-max-microamp = <1200000>;

	status = "okay";
};

&usb {
	dr_mode = "otg";
	usb-psy-name = "qcom-battmgr-usb";
	usb-role-switch;
	port-select-gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
	pinctrl-0 = <&eusb_mux>;
	pinctrl-names = "default";
	maximum-speed = "super-speed-plus-gen2x1";

	status = "okay";

	ports {
		/* The long-edge connector takes priority on the shared data bus. */
		port@0 {
			reg = <0>;

			usb_dwc3_hs: endpoint {
				remote-endpoint = <&pmic_glink_hs_in>;
				usb-role-switch;
				mux-state = <0>;
			};
		};

		port@2 {
			reg = <2>;

			usb_dwc3_hs2: endpoint {
				remote-endpoint = <&pmic_glink_hs_c2_in>;
				usb-role-switch;
				mux-state = <1>;
			};
		};
	};
};

&usb_dp_qmpphy {
	vdda-phy-supply = <&vreg_l3g_1p2>;
	vdda-pll-supply = <&vreg_l2d_0p88>;

	mode-switch;
	orientation-switch;

	status = "okay";
};

&usb_dp_qmpphy_dp_in {
	remote-endpoint = <&mdss_dp0_out>;
};

&usb_dp_qmpphy_out {
	remote-endpoint = <&pmic_glink_ss_in>;
};

&usb_hsphy {
	vdd-supply = <&vreg_l2d_0p88>;
	vdda12-supply = <&vreg_l3g_1p2>;

	phys = <&eusb_repeater>;

	status = "okay";
};

&apps_smmu {
	qcom,preserve-boot-mappings;
};
