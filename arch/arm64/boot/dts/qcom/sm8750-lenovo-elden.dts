	sound {
		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
		model = "Lenovo-Y700-Gen4";
		pinctrl-names = "default";
		pinctrl-0 = <&secondary_mi2s_default>;
		widgets = "Speaker", "Left Speaker", "Speaker", "Right Speaker";
		audio-routing = "Left Speaker", "Left OUT",
				"Right Speaker", "Right OUT";

		mi2s-dai-link {
			link-name = "Secondary MI2S";
			cpu {
				sound-dai = <&q6apmbedai SECONDARY_MI2S_RX>;
			};
			codec {
				sound-dai = <&speaker_left>, <&speaker_right>;
			};
			platform {
				sound-dai = <&q6apm>;
			};
		};
	};

	aliases {
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c9 = &i2c9;
		i2c10 = &i2c10;
		serial1 = &uart14;
	};

	/* mandatory, ABL requires the chosen node (not the fb) to boot */
	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer: framebuffer@fc800000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfc800000 0x0 0x2b00000>;
			width = <1904>;
			height = <3040>;
			stride = <(1904 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/* Exact bootloader-populated RAM map captured from the working tablet. */
	memory@a0000000 {
		device_type = "memory";
		reg = <0x0 0x81960000 0x0 0xa0000>,
		      <0x0 0x81a40000 0x0 0x1c0000>,
		      <0x0 0x81cf4000 0x0 0xc000>,
		      <0x0 0x82460000 0x0 0x40000>,
		      <0x0 0xd8600000 0x0 0x0>,
		      <0x0 0xe3720000 0x0 0x1c0e0000>,
		      <0x8 0x80000000 0x0 0x2f700000>,
		      <0x8 0xb0000000 0x0 0x5500000>,
		      <0xa 0x0 0x2 0x0>,
		      <0x8 0xc0000000 0x1 0x40000000>,
		      <0x0 0x82800000 0x0 0x2200000>,
		      <0x0 0x89d80000 0x0 0x1c80000>,
		      <0x0 0xa2880000 0x0 0x15780000>,
		      <0x0 0xb81c0000 0x0 0x1cc63000>,
		      <0x0 0xd5100000 0x0 0x2f00000>;
	};

	clocks {
		xo_board: xo-board {
			compatible = "fixed-clock";
			clock-frequency = <76800000>;
			#clock-cells = <0>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};

		bi_tcxo_div2: bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-mult = <1>;
			clock-div = <2>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
			clock-mult = <1>;
			clock-div = <2>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&volume_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic_glink: pmic-glink {
		compatible = "qcom,sm8750-pmic-glink",
			     "qcom,sm8550-pmic-glink",
			     "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;
		orientation-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
		qcom,battery-current-inverted;

		/* Long edge */
		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;

			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_ss_in: endpoint {
						remote-endpoint = <&usb_dp_qmpphy_out>;
					};
				};

				port@2 {
					reg = <2>;

					pmic_glink_sbu: endpoint {
						remote-endpoint = <&fsa4480_sbu_mux>;
					};
				};
			};
		};

		/* Short edge */
		connector@1 {
			compatible = "usb-c-connector";
			reg = <1>;

			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_c2_in: endpoint {
						remote-endpoint = <&usb_dwc3_hs2>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_hs_sbu: endpoint {
						remote-endpoint = <&fsa4480_hs_sbu_mux>;
					};
				};
			};
		};
	};

	/* WCN7861 uses the WCN7850 rails plus a Peach-specific AOSS setup. */
	wcn7861-pmu {
		compatible = "qcom,wcn7861-pmu";

		qcom,qmp = <&aoss_qmp>;
		qcom,pdc-init-table =
			"{class: wlan_pdc, ss: rf, res: s5f.m, enable: 1}",
			"{class: wlan_pdc, ss: rf, res: s5f.v, enable: 1}",
			"{class: wlan_pdc, ss: rf, res: s5f.v, upval: 876}",
			"{class: wlan_pdc, ss: rf, res: s5f.v, dwnval: 876}";
		qcom,vreg-pdc-map =
			"s5f:rf",
			"s4d:bb",
			"s3g:rf",
			"s7i:rf";
		qcom,pmu-vreg-map =
			"VDDD_AON_0P9:s5f",
			"VDDA_RFA_1P9:s3g",
			"VDDA_RFA_1P3:s7i",
			"VDDA_RFA_0P9:s5f",
			"VDDD_WLMX_0P9:s4d",
			"VDDD_WLCX_0P9:s5f",
			"VDDD_BTCX_0P9:s5f",
			"VDDD_BTCMX_0P9:s5f",
			"VDDA_PCIE_1P2:s7i",
			"VDDA_PCIE_0P9:s7i";

		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en>, <&wlan_sw_ctrl>,
			    <&wlan_sw_ctrl_wl_cx>, <&wlan_host_sol>,
			    <&bt_uwb_en>, <&bt_fmd_clk_en>;

		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;

		/* Lenovo downstream WCN7861 (Peach) external power grid. */
		vdd-supply = <&vreg_s5f_0p5>;
		vddio-supply = <&vreg_l3f_1p8>;
		vddio1p2-supply = <&vreg_l2f_1p2>;
		vddaon-supply = <&vreg_s4d_0p85>;
		vdddig-supply = <&vreg_s5f_0p5>;
		vddrfa1p2-supply = <&vreg_s7i_1p2>;
		vddrfa1p8-supply = <&vreg_s3g_1p8>;

		/*
		 * The stock Peach btpower driver only votes RPMH_RF_CLK1 from
		 * UPDATE_SOC_VER in the Find My Device path.  Normal BT/WLAN power-on
		 * leaves it off; exposing it here would make generic pwrseq vote it for
		 * every ordinary target enable.
		 */

		regulators {
			vreg_wlan_pmu_rfa_cmn: ldo0 {
				regulator-name = "vreg_wlan_pmu_rfa_cmn";
			};

			vreg_wlan_pmu_aon_0p59: ldo1 {
				regulator-name = "vreg_wlan_pmu_aon_0p59";
			};

			vreg_wlan_pmu_wlcx_0p8: ldo2 {
				regulator-name = "vreg_wlan_pmu_wlcx_0p8";
			};

			vreg_wlan_pmu_wlmx_0p85: ldo3 {
				regulator-name = "vreg_wlan_pmu_wlmx_0p85";
			};

			vreg_wlan_pmu_btcmx_0p85: ldo4 {
				regulator-name = "vreg_wlan_pmu_btcmx_0p85";
			};

			vreg_wlan_pmu_rfa_0p8: ldo5 {
				regulator-name = "vreg_wlan_pmu_rfa_0p8";
			};

			vreg_wlan_pmu_rfa_1p2: ldo6 {
				regulator-name = "vreg_wlan_pmu_rfa_1p2";
			};

			vreg_wlan_pmu_rfa_1p8: ldo7 {
				regulator-name = "vreg_wlan_pmu_rfa_1p8";
			};

			vreg_wlan_pmu_pcie_0p9: ldo8 {
				regulator-name = "vreg_wlan_pmu_pcie_0p9";
			};

			vreg_wlan_pmu_pcie_1p8: ldo9 {
				regulator-name = "vreg_wlan_pmu_pcie_1p8";
			};
		};
	};

	reserved-memory {
		ramoops@c2000000 {
			compatible = "ramoops";
			reg = <0 0xc2000000 0 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
			no-map;
		};

		/*
		 * Use this to tell the BL to initialize the display related
		 * resources, so we can use efifb. Please 's/-/_/'
		 */
		splash_mem: splash-region@fc800000 {
			reg = <0 0xfc800000 0 0x2b00000>;
			no-map;
		};
	};

	vph_pwr: regulator-vph-pwr {
		compatible = "regulator-fixed";

		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;

		regulator-always-on;
		regulator-boot-on;
	};

	vreg_1v8_vddio: regulator-1v8-vddio {
		compatible = "regulator-fixed";

		regulator-name = "vreg_1v8_vddio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		gpio = <&tlmm 161 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&vddio_reg_en>;
		pinctrl-names = "default";

		regulator-always-on;
		regulator-boot-on;
	};

	vreg_6v1_vsp: regulator-6v1-vsp {
		compatible = "regulator-fixed";

		regulator-name = "vreg_6v1_vsp";
		regulator-min-microvolt = <6100000>;
		regulator-max-microvolt = <6100000>;

		gpio = <&tlmm 72 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&vsp_reg_en>;
		pinctrl-names = "default";

		regulator-always-on;
		regulator-boot-on;
	};

	vreg_5v8_vsn: regulator-5v8-vsn {
		compatible = "regulator-fixed";

		regulator-name = "vreg_5v8_vsn";
		regulator-min-microvolt = <5800000>;
		regulator-max-microvolt = <5800000>;

		gpio = <&tlmm 73 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		pinctrl-0 = <&vsn_reg_en>;
		pinctrl-names = "default";

		regulator-always-on;
		regulator-boot-on;
	};
};

